# Skybee на власному хостингу (Apache, NIC.UA). Workflow .github/workflows/hosting.yml кладе цей файл у корінь сайту.
DirectoryIndex index.html
Options -Indexes

# свої сторінки помилок (404.html ще й перекидає адреси без «#», як /profile/x, у застосунок)
ErrorDocument 403 /errors/403.html
ErrorDocument 404 /404.html
ErrorDocument 500 /errors/500.html
ErrorDocument 502 /errors/502.html
ErrorDocument 503 /errors/503.html
ErrorDocument 504 /errors/504.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # лише https: без нього не працюють service worker, сповіщення й встановлення як застосунку.
  # Спершу ввімкни безкоштовний SSL (Let's Encrypt) у панелі NIC.UA, інакше сайт не відкриється.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  # www → без www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/javascript .js .mjs
  AddType text/vtt .vtt
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  # CSP also as a header for the app page: there frame-ancestors works (a <meta> ignores it). Keep it the same as the
  # <meta> in index.html (without the desktop app: scheme). Not on the error pages: they have small inline scripts of their own
  <Files "index.html">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; media-src 'self' https: blob:; connect-src 'self' https:; font-src 'self' data:; worker-src 'self' blob:; manifest-src 'self'; frame-src https://www.youtube-nocookie.com https://player.vimeo.com https://player.twitch.tv https://open.spotify.com https://w.soundcloud.com https://embed.music.apple.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  </Files>
  # nothing the site does not use: no camera, microphone, location, payments; motion sensors only for the glass tilt
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(self), gyroscope=(self)"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # service pages stay out of search results even if a crawler ignores their <meta>
  <FilesMatch "^(404|offline|403|500|502|503|504)\.html$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  # дані позицій виконавців читають застосунки з інших адрес
  <Files "stars.json">
    Header set Access-Control-Allow-Origin "*"
  </Files>
  # «спершу мережа»: оболонка, service worker і дані завжди свіжі
  <FilesMatch "\.(html|js|css|json|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|ico|svg|webp|jpg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# службові файли (.htaccess, .ftpquota тощо) не віддавати
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
